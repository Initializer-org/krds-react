{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@krds.ui/react": ["./src/index.ts"]
    }
  },
  "include": ["src", "docs/components/demos"],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
