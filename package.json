{
  "name": "@krds.ui/react",
  "version": "0.1.1",
  "description": "대한민국 정부 디자인 시스템(KRDS) React 컴포넌트 라이브러리 - 공식 krds-react 1.1.1 포팅, 접근성 수정·자동 검사, Next.js App Router 지원",
  "keywords": [
    "krds",
    "design-system",
    "react",
    "components",
    "ui-library",
    "typescript",
    "korea",
    "korean",
    "government",
    "government-design-system",
    "public-sector",
    "accessibility",
    "a11y",
    "nextjs"
  ],
  "author": "Initializer Team",
  "license": "ISC",
  "homepage": "https://react.krds.initializer.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Initializer-org/krds-react.git"
  },
  "bugs": {
    "url": "https://github.com/Initializer-org/krds-react/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style": {
      "types": "./style.d.ts",
      "default": "./dist/index.css"
    },
    "./dist/index.css": {
      "types": "./style.d.ts",
      "default": "./dist/index.css"
    },
    "./dist/img/*": "./dist/img/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "style.d.ts"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "pnpm run type-check && vite build",
    "type-check": "node node_modules/typescript7/bin/tsc --noEmit",
    "ssr-smoke": "node scripts/ssr-smoke.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "vitest",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^4.1.12",
    "axe-core": "~4.14.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "playwright": "^1.64.1",
    "react": "^18.3.1",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "^18.3.1",
    "typescript": "6.0.3",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "^4.1.12",
    "vue": "^3.5.44"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@12.11.2",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
